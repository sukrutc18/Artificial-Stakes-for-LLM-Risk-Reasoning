# Copy to .env and fill in. Never commit .env.

# Anthropic (Claude Sonnet LLM-as-judge)
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace (for gated Llama-3.1-8B weights and MedQA / ConvFinQA)
HF_TOKEN=hf_...

# vLLM (if served on a remote host). Default: http://localhost:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Experiment logging
RISK_REASONING_RESULTS_DIR=./results
RISK_REASONING_DATA_DIR=./data
RISK_REASONING_SEED=42
